# =============================================================================
# Ki67 · variáveis de ambiente
#
# Copie este arquivo para .env na raiz do repositório:
#   cp .env.example .env            (bash, zsh e PowerShell)
#   copy .env.example .env          (Prompt de Comando do Windows)
#
# O .env está no .gitignore e NUNCA vai para o Git.
# Nada aqui é segredo: os valores são padrões de desenvolvimento local ou
# marcadores "troque-...". Em produção a API se recusa a iniciar se algum
# segredo ainda tiver o valor de exemplo.
# =============================================================================


# --- App (Expo) ---------------------------------------------------------------
# Variáveis EXPO_PUBLIC_* entram no bundle do app e são PÚBLICAS: nunca coloque
# segredo nelas.
# Endereço da API visto pelo app:
#   web e simulador iOS ............ http://localhost:3000
#   emulador Android ............... http://10.0.2.2:3000
#   celular físico com Expo Go ..... http://<IP-da-sua-máquina-na-rede>:3000
EXPO_PUBLIC_API_URL=http://localhost:3000


# --- API (NestJS) ---------------------------------------------------------------
NODE_ENV=development
API_PORT=3000
# Origens que o navegador pode usar para chamar a API (CORS), separadas por vírgula.
# 8081 é a porta padrão do Expo na web.
CORS_ORIGINS=http://localhost:8081


# --- Banco de dados (Supabase · PostgreSQL 17) ----------------------------------
# DATABASE_URL: conexão usada pela API em execução (Prisma).
# DIRECT_URL:   conexão direta, usada só pelas migrações (npm run db:migrate).
#
# Local, com "npx supabase start": as duas apontam para o banco local. postgres:postgres
# é a credencial padrão e pública do Supabase CLI, válida só na sua máquina.
#
# Nuvem (implantação): copie as strings em Supabase > Connect.
#   DATABASE_URL = pooler em modo transação (porta 6543), com ?pgbouncer=true no final,
#                  usando o usuário ki67_api (sem UPDATE/DELETE no log e nas versões)
#   DIRECT_URL   = conexão direta ou pooler em modo sessão (porta 5432)
# As credenciais da nuvem ficam só no .env de quem implanta, nunca no repositório.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# O app (Expo) não recebe nenhuma chave do Supabase: ele só fala com a API.
# Nunca coloque a chave service_role do Supabase em variável EXPO_PUBLIC_*.


# --- Autenticação (RF-01, RF-02, RF-05) -----------------------------------------
# Gere um segredo diferente para cada variável e para cada ambiente:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=troque-por-um-segredo-aleatorio
JWT_REFRESH_SECRET=troque-por-outro-segredo-aleatorio
# Duração do token de acesso e da sessão renovável
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# Tempo sem atividade até a sessão expirar (RF-05)
SESSION_IDLE_TIMEOUT=30m
# Validade e tentativas do código de segundo fator enviado por e-mail (RF-02)
TWO_FACTOR_CODE_TTL=10m
TWO_FACTOR_MAX_ATTEMPTS=5


# --- Administrador inicial (criado por "npm run db:seed") -----------------------
# Só para desenvolvimento: troque a senha no primeiro acesso.
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_EMAIL=admin@ki67.local
SEED_ADMIN_PASSWORD=troque-esta-senha-no-primeiro-acesso


# --- E-mail: código 2FA e recuperação de senha (RF-02, RF-03) -------------------
# Em desenvolvimento o Mailpit do Supabase local captura todos os e-mails:
# caixa em http://127.0.0.1:54324 e SMTP na porta 54325 (seção [inbucket] do
# supabase/config.toml). Em produção, use o SMTP da instituição ou de um provedor.
SMTP_HOST=127.0.0.1
SMTP_PORT=54325
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Ki67 <nao-responda@ki67.local>"


# --- Armazenamento das imagens (RF-11, RNF-06) ----------------------------------
# local = pasta privada no servidor (desenvolvimento)
# r2    = bucket privado no Cloudflare R2, pela API compatível com S3 (produção)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
# Segredo usado para assinar as URLs temporárias das imagens
STORAGE_URL_SIGNING_SECRET=troque-por-um-segredo-aleatorio
SIGNED_URL_TTL=5m
# Preencha somente se STORAGE_DRIVER=r2. Endpoint e chaves ficam no painel da
# Cloudflare (R2 > API tokens), só no .env de quem implanta. O app nunca recebe
# essas chaves: as imagens chegam a ele por URL assinada gerada pela API.
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_BUCKET=ki67-imagens
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=


# --- Upload de imagens (RF-08) ---------------------------------------------------
UPLOAD_MAX_FILE_MB=50
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/tiff
