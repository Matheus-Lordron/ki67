# =============================================================================
# Segmenta Studio Ki-67 · variáveis do APP (Expo)
#
# Copie para apps/mobile/.env e preencha:
#   cp .env.example .env            (bash, zsh e PowerShell)
#   copy .env.example .env          (Prompt de Comando do Windows)
# Depois de mudar o .env, pare o Expo (Ctrl+C) e rode de novo.
#
# Tudo que começa com EXPO_PUBLIC_ entra no app e é PÚBLICO.
# NUNCA coloque aqui a chave service_role/secret do Supabase nem chaves do R2:
# essas ficam só nas Edge Functions (supabase/functions/.env.example).
# =============================================================================

# Supabase > Project Settings > API (ou o botão "Connect" no topo do painel)
#   Project URL ...................... https://<seu-projeto>.supabase.co
#   Publishable key (sb_publishable_...) ou, em projetos antigos, a chave "anon"
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_COLE_AQUI

# Limite de upload por arquivo (RF-08). O banco também confere: 50 MB.
EXPO_PUBLIC_UPLOAD_MAX_MB=50
