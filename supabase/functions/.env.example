# =============================================================================
# Segredos das Edge Functions do Supabase (servidor). NUNCA vão para o app.
#
# Na nuvem: Supabase > Edge Functions > Secrets (ou, pelo terminal:
#   npx supabase secrets set --env-file supabase/functions/.env)
# Local:    copie para supabase/functions/.env (o .gitignore já ignora).
#
# SUPABASE_URL e as chaves do projeto já existem automaticamente dentro das
# funções: não cadastre nada que comece com SUPABASE_.
# =============================================================================

# --- Cloudflare R2 (bucket privado) ---------------------------------------------
# Cloudflare > R2 > Overview: o "Account ID" aparece na lateral direita.
# Cloudflare > R2 > Manage API tokens > Create API token
#   Permissão "Object Read & Write", restrita ao bucket abaixo.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=ki67-imagens
# Validade das URLs assinadas, em segundos (RNF-06: 5 min para leitura)
R2_DOWNLOAD_URL_TTL=300
R2_UPLOAD_URL_TTL=600

# --- E-mail do código 2FA (RF-02) ------------------------------------------------
# As Edge Functions não podem usar SMTP (portas 25 e 587 bloqueadas): o código
# sai pela API HTTP do Resend (https://resend.com > API Keys).
RESEND_API_KEY=
# Sem domínio verificado no Resend, use onboarding@resend.dev (só envia para o
# e-mail da sua própria conta do Resend). Com domínio: nao-responda@seu-dominio
MAIL_FROM="Segmenta Studio Ki-67 <onboarding@resend.dev>"
# SÓ EM DESENVOLVIMENTO: sem RESEND_API_KEY, escreve o código no log da função.
DEV_LOG_2FA_CODE=false

# --- Endereço do app ---------------------------------------------------------------
# Usado no link de "definir senha" enviado aos novos usuários.
APP_URL=http://localhost:8081
# Origens que podem chamar as funções pelo navegador (CORS), separadas por vírgula.
APP_ORIGINS=http://localhost:8081
